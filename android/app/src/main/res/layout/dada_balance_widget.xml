<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/balance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo totale"
            android:textColor="#A1A1AA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/balance_widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0,00 €"
            android:textColor="#F7F7F8"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance_widget_add"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#09090B"
        android:textSize="28sp"
        android:textStyle="bold"
        android:contentDescription="Aggiungi spesa"
        android:background="@drawable/widget_add_background" />
</LinearLayout>
