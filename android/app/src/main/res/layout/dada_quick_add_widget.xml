<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aggiungi movimento"
        android:textColor="#F7F7F8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_widget_expense"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Spesa" />
        <TextView
            android:id="@+id/quick_widget_income"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Entrata" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_widget_transfer"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Trasferisci" />
        <TextView
            android:id="@+id/quick_widget_category"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Spesa" />
    </LinearLayout>
</LinearLayout>
