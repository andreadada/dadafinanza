diff --git a/test/goal_planning_service_test.dart b/test/goal_planning_service_test.dart
new file mode 100644
--- /dev/null
+++ b/test/goal_planning_service_test.dart
@@ -0,0 +1,144 @@
+import 'package:dadafinanza/app_state.dart';
+import 'package:dadafinanza/data/app_database.dart';
+import 'package:dadafinanza/models/models.dart';
+import 'package:dadafinanza/services/goal_ledger_service.dart';
+import 'package:dadafinanza/services/goal_planning_service.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('manual goal ledger deltas never go below zero or above target', () {
+    expect(
+      GoalLedgerService.clampManualDelta(
+        current: 80,
+        target: 100,
+        delta: 50,
+      ),
+      20,
+    );
+    expect(
+      GoalLedgerService.clampManualDelta(
+        current: 30,
+        target: 100,
+        delta: -80,
+      ),
+      -30,
+    );
+  });
+
+  test('budget guardrail reduces aggressive goal saving suggestions', () {
+    final now = DateTime(2026, 9, 15, 12);
+    final state = AppState(AppDatabase());
+    state.accounts = [
+      Account(
+        id: 1,
+        name: 'Principale',
+        balance: 5000,
+        colorValue: 0xFF777777,
+        iconKey: 'bank',
+        accountType: AccountType.checking,
+        includeInTotal: true,
+        includeInAnalytics: true,
+        isLocked: false,
+        isArchived: false,
+        hideBalance: false,
+        isSystem: false,
+        createdAt: now,
+        updatedAt: now,
+      ),
+    ];
+    state.transactions = [
+      for (var week = 1; week <= 4; week++) ...[
+        FinanceTransaction(
+          id: week * 10,
+          type: TransactionType.income,
+          amount: 300,
+          accountId: 1,
+          date: now.subtract(Duration(days: week * 7)),
+          includeInAnalytics: true,
+          createdAt: now,
+          updatedAt: now,
+        ),
+        FinanceTransaction(
+          id: week * 10 + 1,
+          type: TransactionType.expense,
+          amount: 100,
+          accountId: 1,
+          categoryId: 1,
+          date: now.subtract(Duration(days: week * 7)),
+          includeInAnalytics: true,
+          createdAt: now,
+          updatedAt: now,
+        ),
+      ],
+    ];
+    state.budgets = [
+      Budget(
+        id: 1,
+        name: 'Spese mese',
+        limit: 2000,
+        period: BudgetPeriod.monthly,
+        startDate: DateTime(2026, 9, 1),
+        enabled: true,
+      ),
+    ];
+    final goal = Goal(
+      id: 1,
+      name: 'Viaggio',
+      iconKey: 'savings',
+      colorValue: 0xFF777777,
+      targetAmount: 1000,
+      currentAmount: 0,
+      targetDate: now.add(const Duration(days: 140)),
+      archived: false,
+      completed: false,
+    );
+    state.goals = [goal];
+
+    final withoutBudgetGuardrail = state.goalPlan(goal, now: now);
